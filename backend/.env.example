PORT=4000
# MongoDB connection string. Atlas example:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mingleo?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mingleo
# Required in production: a long random string used to sign session cookies.
JWT_SECRET=change-me-to-a-long-random-string
# Frontend origin(s) allowed by CORS, comma-separated.
WEB_ORIGIN=http://localhost:3100
PROPOSALS_PER_HOUR=20
# Integration tests use a separate database that they create and drop. It must end in "_test".
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/mingleo_test
